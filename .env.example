PORT=3001
FRONTEND_URL=http://localhost:3000
# Lista separada por vírgula de origens permitidas no CORS (produção).
# Em produção, defina explicitamente; se vazio, cai para FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=wepgcomp
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432
DATABASE_URL="postgresql://root:root@localhost:5432/wepgcomp"

# Use um segredo forte e único (ex.: openssl rand -hex 32). NÃO commitar o valor real.
JWT_SECRET=change-me-use-a-strong-random-secret

# SMTP Configuration
# Local: use um SMTP de teste (ex.: Mailpit -> SMTP_HOST=localhost, SMTP_PORT=1025,
# caixa de entrada em http://localhost:8025). O cliente sempre envia usuário/senha.
SMTP_HOST=
SMTP_PORT=
# true apenas para porta 465 (TLS direto)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

SEED_PASSWORD=change-me-strong-seed-password

# Endpoint substituível para geocodificação do endereço do evento (consultas apenas no salvamento).

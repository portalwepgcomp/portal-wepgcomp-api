{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=20.11",
    "npm": ">=10"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:dev": "nest build",
    "build:vercel": "npm run build && vercel --prod",
    "build:vercel:dev": "npm run build:dev && vercel --prod",
    "vercel:link": "vercel link --yes --project portal-wepgcomp-api",
    "vercel:link:dev": "vercel link --yes --project portal-wepgcomp-api-development",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts --max-warnings 0",
    "lint:fix": "eslint src test --ext .ts --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "npx prisma migrate deploy && node dist/main",
    "start:vercel": "npm run build && vercel dev",
    "start:prod:render": "npm install && npm run build && node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:migrate": "prisma db push",
    "postinstall": "prisma generate",
    "clean": "rm -rf package-lock.json node_modules && npm cache clean --force",
    "seed": "ts-node prisma/seed.ts",
    "swagger:export": "nest build && node dist/scripts/export-swagger.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.20.0",
    "axios": "^1.13.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.2.0",
    "nodemailer": "^10.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.18",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.13.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "chokidar": "^5.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^5.20.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "brace-expansion": "^2.1.4",
    "file-type": "^21.3.2",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "minimatch": "^9.0.7",
    "multer": "^2.1.2",
    "picomatch": "^4.0.4",
    "qs": "^6.14.1",
    "tar": "^7.5.22",
    "uuid": "^11.1.1",
    "yauzl": "^3.2.1",
    "@angular-devkit/core": {
      "ajv": "^8.18.0"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
